<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="AIEModelStoreContainer" CdmEntityContainer="EntitiesAPI">
    <EntitySetMapping Name="qryApiContactUs">
      <EntityTypeMapping TypeName="AIEModel.qryApiContactU">
        <MappingFragment StoreEntitySet="qryApiContactUs">
          <ScalarProperty Name="ContactUsId" ColumnName="ContactUsId" />
          <ScalarProperty Name="FullName" ColumnName="FullName" />
          <ScalarProperty Name="Email" ColumnName="Email" />
          <ScalarProperty Name="MobileNo" ColumnName="MobileNo" />
          <ScalarProperty Name="Message" ColumnName="Message" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="qryApiUsers">
      <EntityTypeMapping TypeName="AIEModel.qryApiUser">
        <MappingFragment StoreEntitySet="qryApiUsers">
          <ScalarProperty Name="PasswordExpired" ColumnName="PasswordExpired" />
          <ScalarProperty Name="UserPass" ColumnName="UserPass" />
          <ScalarProperty Name="UserName" ColumnName="UserName" />
          <ScalarProperty Name="ApiUserID" ColumnName="ApiUserID" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="qryApiUserLogins">
      <EntityTypeMapping TypeName="AIEModel.qryApiUserLogin">
        <MappingFragment StoreEntitySet="qryApiUserLogin">
          <ScalarProperty Name="FullName" ColumnName="FullName" />
          <ScalarProperty Name="Username" ColumnName="Username" />
          <ScalarProperty Name="Password" ColumnName="Password" />
          <ScalarProperty Name="Email" ColumnName="Email" />
          <ScalarProperty Name="ID" ColumnName="ID" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="APICountDowns">
      <EntityTypeMapping TypeName="AIEModel.APICountDown">
        <MappingFragment StoreEntitySet="APICountDown">
          <ScalarProperty Name="CountDownEndDate" ColumnName="CountDownEndDate" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
  </EntityContainerMapping>
</Mapping>