<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="PublicAr.master.cs" Inherits="AIE.PublicAr" %>

<!DOCTYPE html>
<html lang="zxx">
<head runat="server">
    <meta charset="utf-8" />
    <title>Annual Innovation Event</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="Annual Innovation Event" name="description" />
    <meta content="" name="keywords" />
    <meta content="" name="author" />

    <!--[if lt IE 9]>
            <script src="../Content/js/html5shiv.js"></script>
        <![endif]-->

    <!-- CSS Files
    ================================================== -->
    <link id="bootstrap" href="~/Content/css/bootstrap-rtl.min.css" rel="stylesheet" type="text/css" />
    <link id="bootstrapgrid" href="~/Content/css/bootstrap-grid-rtl.min.css" rel="stylesheet" type="text/css" />
    <link id="bootstrapreboot" href="~/Content/css/bootstrap-reboot-rtl.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/animate.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/owl.carousel.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/owl.theme.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/owl.transitions.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/magnific-popup.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/jquery.countdown.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/style.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/font/font.css" rel="stylesheet" />
    <!-- color scheme -->
    <link id="colors" href="~/Content/css/colors/scheme-01.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/coloring.css" rel="stylesheet" type="text/css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/images/favico.png" rel="icon" />
    <style>
        .de-flex-col {
            display: flex;
            align-items: center; /* Ensures vertical alignment of child elements */
        }

        #logo {
            display: flex;
            align-items: center; /* Ensures the logo is vertically aligned */
        }

            #logo img {
                max-height: 100%; /* Prevents image overflow */
                height: auto; /* Ensures responsiveness */
            }

        @media (min-width: 768px) and (max-width: 1024px) {
            /* Specific styles for iPads in portrait or landscape mode */
            #logo {
                margin: 0 auto; /* Center-align if needed */
                padding: 0; /* Reset padding */
            }
        }

        .bg-image {
            height: 200px; /* Height adjusts based on content */
            min-height: 50vh; /* Ensures a minimum height */
            display: flex;
            align-items: center;
            justify-content: center;
            padding-top: 20%; /* Adds space at the top */
            padding-bottom: 20%; /* Adds space at the bottom */
            background-size: cover; /* Crops to fill container */
            background-position: center; /* Centers image */
            background-repeat: no-repeat; /* Prevents tiling */
        }

        .bg-image-small {
            height: 200px; /* Height adjusts based on content */
            min-height: 40vh; /* Ensures a minimum height */
            display: flex;
            align-items: center;
            justify-content: center;
            background-size: cover; /* Crops to fill container */
            background-position: center; /* Centers image */
            background-repeat: no-repeat; /* Prevents tiling */
        }

        .active {
            text-decoration: underline; /* Keeps the underline visible */
            font-weight: bold; /* Optional: Add any styling to highlight */
        }


        @media (max-width: 768px) {
            ul#mainmenu li a.active {
                text-decoration: underline !important;
                font-weight: bold; /* Ensure visibility on mobile */
            }
        }


    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>
    <form id="form1" runat="server">
        <div id="wrapper">
            <div id="topbar" class="text-white bg-color">
                <div class="container">


                    <div class="topbar-left">
                        <span class="topbar-widget" runat="server" id="liProfile">
                            <asp:LinkButton ID="BtnProfile" runat="server" PostBackUrl="~/Ar_Sa/Profile.aspx" CssClass="text-white droidkufiregular"><i class="fa fa-user-circle-o"></i>ملفي</asp:LinkButton>
                        </span>


                        <span class="topbar-widget" runat="server" id="liDashboard">
                            <asp:LinkButton ID="BtnDashboard" runat="server" PostBackUrl="~/Dashboard.aspx" CssClass="text-white droidkufiregular"><i class="fa fa-dashboard"></i>لوحة القيادة</asp:LinkButton>

                        </span>
                        <span class="topbar-widget" runat="server" id="liLogOut">
                            <asp:LinkButton ID="BtnSignOut" runat="server" CssClass="droidkufiregular text-white" OnClick="BtnSignOut_Click">تسجيل الخروج  <i class="fa fa-key"></i></asp:LinkButton>

                        </span>
                        <span class="topbar-widget" runat="server" id="liLogin">
                            <a href="Login" class="droidkufiregular">الدخول   <i class=" icon_lock-open"></i></a>

                        </span>
                        <span class="topbar-widget" runat="server" id="Span4">
                            <asp:LinkButton ID="BtnToEn" runat="server" CssClass="text-white" OnClick="BtnToEn_Click">English <i class="fa fa-language"></i></asp:LinkButton>

                        </span>

                    </div>
                    <div class="clearfix"></div>
                </div>
            </div>

            <!-- header begin -->
            <header class="bg-white scroll-light">
                <div class="">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="de-flex sm-pt10" dir="ltr">
                                <div class="de-flex-col">
                                    <div id="logo">
                                        <a href="~/Ar_sa/" runat="server">
                                            <img alt="" class="logo" src="../Content/images/2025/logo.png" width="300" />
                                            <img alt="" class="logo-2" src="../Content/images/2025/logo-2.png" />
                                        </a>
                                    </div>
                                  
                                </div>
                                <div class="de-flex-col header-col-mid" >
                                    <!-- mainmenu begin -->
                                    <ul id="mainmenu">
                                        <li class="ml-3">
                                            <a href="~/Ar_Sa/" runat="server" id="linkHomeAr" class="droidkufiregular text-dark">الرئيسية<span class="droidkufiregular"> </span></a>
                                        </li>
                                        <li class="ml-3">
                                            <a href="Publication" runat="server" id="linkPublicationAr" class="droidkufiregular text-dark">المطبوعات <span class="droidkufiregular"></span></a>
                                        </li>
                                        <li class="ml-3">
                                            <a href="Schedules" runat="server" id="linkSchedulesAr" class="droidkufiregular text-dark">معرض الابتكار <span class="droidkufiregular"></span></a>
                                        </li>
                                        <li class="ml-3">
                                            <a href="Ceremony" runat="server" id="linkCeremonyAr" class="droidkufiregular text-dark">حفل الابتكار<span class="droidkufiregular"></span></a>
                                        </li>
                                        <li class="ml-3">
                                            <a href="Judges" runat="server" id="linkJudgesAr" class="droidkufiregular text-dark">المحكمون<span class="droidkufiregular"></span></a>
                                        </li>
                                        <li class="ml-3">
                                            <a href="Supervisors" runat="server" id="linkSupervisorsAr" class="droidkufiregular text-dark">المشرفون<span class="droidkufiregular"></span></a>
                                        </li>
                                        <li class="ml-3">
                                            <a href="Sponsors" runat="server" id="linkSponsorsAr" class="droidkufiregular text-dark">الرعاة <span class="droidkufiregular"></span></a>
                                        </li>
                                        <li class="ml-3">
                                            <a href="ContactUs" runat="server" id="linkContactUsAr" class="droidkufiregular text-dark">اتصل بنا <span class="droidkufiregular"></span></a>
                                        </li>
                                         <li class="ml-3">
                                            <a href="2023Ar" runat="server" id="link2023Ar" class="droidkufiregular text-dark">نسخة 2023 <span class="droidkufiregular"></span></a>
                                        </li>
                                    </ul>

                                </div>
                                <div class="de-flex-col">

                                    <span id="menu-btn"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
            <!-- header close -->
            <!-- content begin -->
            <div class="no-bottom no-top" id="content">
                <div id="top"></div>
                <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>

            </div>
            <!-- content close -->

            <a href="#" id="back-to-top"></a>

            <!-- footer begin -->
            
           

              <footer>
                <div class="row">
                    <div class="col-md-12">
                        <div class="de-flex ml-4">
                            <div class="de-flex-col">
                                <div class="social-icons">
                                    <a href="mailto:iie@iau.edu.sa"><i class="fa fa-envelope-o fa-lg"></i></a>
                                    <a href="https://twitter.com/IAU_VPSRI" target="_blank"><i class="fa-brands fa-x-twitter fa-lg"></i></a>
                                    <a href="https://apps.apple.com/us/app/annual-innovation-event/id6475714056" target="_blank"><i class="fa-brands fa-apple fa-lg"></i></a>
                                    <a href="https://play.google.com/store/apps/details?id=sa.edu.iau.annualinnovationevent" target="_blank"><i class="fa-brands fa-android fa-lg"></i></a>
                                </div>
                            </div>
                            <div class="de-flex-col mr-4">
                                &copy; AIE <%=DateTime.Now.Year.ToString() %> 
                            </div>
                        </div>
                        <img src="../Content/images/2025/DefaultEn/footer.png" class="d-block w-100" alt="...">
                    </div>
                </div>
            </footer>



            <div id="preloader">
                <div class="spinner">
                    <div class="bounce1"></div>
                    <div class="bounce2"></div>
                    <div class="bounce3"></div>
                </div>
            </div>
        </div>

        <%--<div id="cookieConsent">
            <div class="container-fluid">
                <div class="de-flex">
                    <div class="de-flex-content">
                        This website is using cookies. <a href="#" target="_blank">More info</a>.
                    </div>
                    <div class="de-flex-content">
                        <a class="cookieConsentOK">Accept All Cookies</a>
                    </div>
                </div>
            </div>
        </div>--%>
        <%--<div id="selector">
          
            <div id="demo-rtl" class="sc-opt">
                <div class="sc-icon"><i class="fa fa-language"></i></div><span class="sc-val">العربية</span>
            </div>

            <div class="sc-opt sc-mt">
                <div class="sc-icon"><i class="fa fa-eyedropper"></i></div>
                <span class="opt tc1" data-color="scheme-01"></span>
                <span class="opt tc2" data-color="scheme-02"></span>
                <span class="opt tc3" data-color="scheme-03"></span>
                <span class="opt tc4" data-color="scheme-04"></span>
                <span class="opt tc5" data-color="scheme-05"></span>
                <span class="opt tc6" data-color="scheme-06"></span>
                <span class="opt tc7" data-color="scheme-07"></span>
            </div>

        </div>--%>


        <!-- Javascript Files
    ================================================== -->
        <script src="../Content/js/jquery.min.js"></script>
        <script src="../Content/js/popper.min.js"></script>
        <script src="../Content/js/bootstrap.min.js"></script>
        <script src="../Content/js/wow.min.js"></script>
        <script src="../Content/js/jquery.isotope.min.js"></script>
        <script src="../Content/js/easing.js"></script>
        <script src="../Content/js/owl.carousel.js"></script>
        <script src="../Content/js/validation.js"></script>
        <script src="../Content/js/jquery.magnific-popup.min.js"></script>
        <script src="../Content/js/enquire.min.js"></script>
        <script src="../Content/js/jquery.stellar.min.js"></script>
        <script src="../Content/js/jquery.plugin.js"></script>
        <script src="../Content/js/typed.js"></script>
        <script src="../Content/js/jquery.countTo.js"></script>
        <script src="../Content/js/jquery.countdown.js"></script>
        <script src="../Content/js/typed.js"></script>
        <script src="../Content/js/designesia_ar.js"></script>


        <script>
            $(function () {
                // jquery typed plugin
                $(".typed").typed({
                    stringsElement: $('.typed-strings'),
                    typeSpeed: 100,
                    backDelay: 1500,
                    loop: true,
                    contentType: 'html', // or text
                    // defaults to false for infinite loop
                    loopCount: false,
                    callback: function () { null; },
                    resetCallback: function () { newTyped(); }
                });
            });
        </script>
    </form>

</body>
</html>
