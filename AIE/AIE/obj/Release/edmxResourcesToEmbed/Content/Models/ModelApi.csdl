<?xml version="1.0" encoding="utf-8"?>
<Schema Namespace="AIEModel" Alias="Self" annotation:UseStrongSpatialTypes="false" xmlns:annotation="http://schemas.microsoft.com/ado/2009/02/edm/annotation" xmlns:customannotation="http://schemas.microsoft.com/ado/2013/11/edm/customannotation" xmlns="http://schemas.microsoft.com/ado/2009/11/edm">
  <EntityType Name="qryApiContactU">
    <Key>
      <PropertyRef Name="ContactUsId" />
    </Key>
    <Property Name="ContactUsId" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="FullName" Type="String" MaxLength="150" FixedLength="false" Unicode="false" />
    <Property Name="Email" Type="String" MaxLength="80" FixedLength="false" Unicode="false" />
    <Property Name="MobileNo" Type="String" MaxLength="20" FixedLength="false" Unicode="false" />
    <Property Name="Message" Type="String" MaxLength="450" FixedLength="false" Unicode="true" />
  </EntityType>
  <EntityContainer Name="EntitiesAPI" annotation:LazyLoadingEnabled="true">
    <EntitySet Name="qryApiContactUs" EntityType="Self.qryApiContactU" />
    <EntitySet Name="qryApiUsers" EntityType="AIEModel.qryApiUser" />
    <EntitySet Name="qryApiUserLogins" EntityType="AIEModel.qryApiUserLogin" />
    <EntitySet Name="APICountDowns" EntityType="AIEModel.APICountDown" />
  </EntityContainer>
  <EntityType Name="qryApiUser">
    <Key>
      <PropertyRef Name="ApiUserID" />
    </Key>
    <Property Name="ApiUserID" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="UserName" Type="String" MaxLength="250" FixedLength="false" Unicode="true" />
    <Property Name="UserPass" Type="String" MaxLength="4000" FixedLength="false" Unicode="true" />
    <Property Name="PasswordExpired" Type="DateTime" Precision="3" />
  </EntityType>
  <EntityType Name="qryApiUserLogin">
    <Key>
      <PropertyRef Name="ID" />
      <PropertyRef Name="Username" />
    </Key>
    <Property Name="ID" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="Email" Type="String" MaxLength="50" FixedLength="false" Unicode="false" />
    <Property Name="Password" Type="String" MaxLength="150" FixedLength="false" Unicode="true" />
    <Property Name="Username" Type="String" Nullable="false" MaxLength="1" FixedLength="false" Unicode="false" />
    <Property Name="FullName" Type="String" MaxLength="50" FixedLength="false" Unicode="false" />
  </EntityType>
  <EntityType Name="APICountDown">
    <Key>
      <PropertyRef Name="CountDownEndDate" />
    </Key>
    <Property Name="CountDownEndDate" Type="DateTime" Nullable="false" Precision="3" />
  </EntityType>
</Schema>